{
  // Hébergement Cloudflare : l'app (fichiers statiques) et le petit serveur /api/* (apps/worker).
  // Build : npm ci && npm run build ; déploiement : npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  // Adresse publique forge.<compte>.workers.dev, et une adresse de test par branche (versions de test).
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Seules les requêtes /api/* passent par le serveur ; tout le reste est servi directement.
    "run_worker_first": ["/api/*"]
  },
  // Séances audio de FORGE MIND (catalogue, fichiers découpés, couvertures). Le code d'administration est le secret ADMIN_CODE.
  "kv_namespaces": [{ "binding": "AUDIO", "id": "4892a4db27b247dd90839865db5db989" }],
  // Code de l'espace créateur : secret ADMIN_CODE du Secrets Store du compte (valeur saisie par Coz dans Cloudflare, jamais dans le code).
  "secrets_store_secrets": [{ "binding": "ADMIN_CODE", "store_id": "21ab38f21ff84a2b8039be0363735b1b", "secret_name": "ADMIN_CODE" }],
  // Versions de test (Worker Previews) : elles n'héritent pas des liaisons de production. Même catalogue audio et même code que la production.
  "previews": {
    "kv_namespaces": [{ "binding": "AUDIO", "id": "4892a4db27b247dd90839865db5db989" }],
    "secrets_store_secrets": [{ "binding": "ADMIN_CODE", "store_id": "21ab38f21ff84a2b8039be0363735b1b", "secret_name": "ADMIN_CODE" }]
  }
}
